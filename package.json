{
  "name": "@shitpost.work/omp-skill-tracker",
  "version": "0.1.1",
  "description": "OMP/Pi extension that tracks remote SKILL.md files by SHA and auto-updates them on session start.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "omp": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "files": [
    "index.js",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "prebuild": "npm run clean",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build",
    "pack:check": "npm pack --dry-run",
    "verify": "npm run typecheck && npm run build && npm run pack:check"
  },
  "peerDependencies": {
    "@oh-my-pi/pi-coding-agent": ">=16.5.2"
  },
  "peerDependenciesMeta": {
    "@oh-my-pi/pi-coding-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@oh-my-pi/pi-coding-agent": "18.1.19",
    "@types/bun": "^1.4.2",
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://git.shitpost.work/shitpost.work/omp-skill-tracker.git"
  },
  "author": "harutohiroki",
  "license": "MIT"
}
